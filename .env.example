# Provider API keys. Visual Relay calls the providers directly, in process;
# there is no proxy and nothing to start.
#
# Location: ~/.config/visual-relay/.env
#   (or $XDG_CONFIG_HOME/visual-relay/.env when XDG_CONFIG_HOME is set)
#
# Resolution precedence: process env > user-level .env
# An exported key overrides the file; the in-app key panel writes to the
# user-level path.
#
# Keys are resolved per stage: a tier's model chain is filtered to the models
# whose key is present, so a missing key skips that model rather than failing
# the request. A tier with no usable model fails the stage and says which key
# would fix it. No key at all is fine until a stage actually runs.

# Moonshot — backs the kimi-k2 alias (frontier fallback) and the kimi profile.
MOONSHOT_API_KEY=

# DeepSeek — backs the `cheap` and `balanced` tiers with DeepSeek V4.1 Flash,
# which both tiers lead with. The V4 names stay behind it as fallbacks; images
# still go to the `vision` tier.
DEEPSEEK_API_KEY=

# Z.AI (Zhipu AI) first-party API — backs the `frontier` tier's primary model,
# GLM 5.3 Flash. Optional: when this is blank the frontier tier reaches the same
# model over Hugging Face below instead.
ZAI_API_KEY=

# Hugging Face Inference Providers — one token, many upstreams. Backs the
# `vision` tier, the hf-qwen3-coder-next alias, and the `frontier` tier's
# GLM 5.3 Flash route (used as the frontier primary when ZAI_API_KEY is unset).
HF_TOKEN=
