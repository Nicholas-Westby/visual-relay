<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisualRelay.Domain\VisualRelay.Domain.csproj" />
  </ItemGroup>

  <!-- Single source of truth for the nono vr-guard sandbox profile: the same
       file the repo tests validate (packaging/nono/vr-guard.json) is embedded
       in the assembly so NonoProfileEnsurer can self-heal it at runtime whether
       VR is launched from a checkout or an installed/self-contained app. The
       explicit LogicalName pins a stable manifest name for the runtime read. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\nono\vr-guard.json"
                      LogicalName="VisualRelay.Core.vr-guard.json" />
    <EmbeddedResource Include="..\..\packaging\task-templates\blank.md"
                      LogicalName="VisualRelay.Core.task-templates.blank.md" />
    <EmbeddedResource Include="..\..\packaging\task-templates\speed-up-automated-tests.md"
                      LogicalName="VisualRelay.Core.task-templates.speed-up-automated-tests.md" />
    <!-- Template attachments: files under packaging/task-templates/<id>/ ship
         beside their template and are copied into the task folder on creation.
         The '/' in the LogicalName separates the template id from the file name
         so TaskTemplates.Load can tell attachments from templates. -->
    <EmbeddedResource Include="..\..\packaging\task-templates\speed-up-automated-tests\commit-message-evidence.md"
                      LogicalName="VisualRelay.Core.task-templates.speed-up-automated-tests/commit-message-evidence.md" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VisualRelay.Tests" />
    <!-- The GUI gate (MainWindowViewModel.EnsureRunnableAsync) reuses the
         runner's internal MissingToolsMessage so both surfaces stay identical. -->
    <InternalsVisibleTo Include="VisualRelay.App" />
    <!-- ShellFormatGuard calls ProcessCapture.RunAsync for the shfmt format gate. -->
    <InternalsVisibleTo Include="VisualRelay.Guards" />
  </ItemGroup>

</Project>
