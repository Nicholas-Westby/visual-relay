<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualRelay.App.ViewModels"
             x:Class="VisualRelay.App.Views.Controls.CostPerModel"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">
  <StackPanel Spacing="6">
    <ItemsControl ItemsSource="{Binding ModelCostRows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MainWindowViewModel+ModelCostRow">
          <Border Background="#12151C"
                  BorderBrush="#252A33"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DisplayName}"
                         FontSize="13" FontWeight="Bold"
                         Foreground="#F2F5FA"/>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="Input:"
                           FontSize="12" Foreground="#9AA3B1"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding InputRate, StringFormat='${0} per 1M tokens'}"
                           FontSize="12" Foreground="#E7ECF3"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="Output:"
                           FontSize="12" Foreground="#9AA3B1"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding OutputRate, StringFormat='${0} per 1M tokens'}"
                           FontSize="12" Foreground="#E7ECF3"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="Cached input:"
                           FontSize="12" Foreground="#9AA3B1"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding CachedInputRate, StringFormat='${0} per 1M tokens'}"
                           FontSize="12" Foreground="#E7ECF3"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="Cache write:"
                           FontSize="12" Foreground="#9AA3B1"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding CacheWriteDisplay}"
                           FontSize="12" Foreground="#E7ECF3"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Time-of-day windows -->
              <StackPanel Spacing="4"
                          IsVisible="{Binding HasWindows}"
                          Margin="0,4,0,0">
                <TextBlock Text="Time-of-day peak windows:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#E0A458"/>
                <ItemsControl ItemsSource="{Binding Windows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MainWindowViewModel+ModelCostWindowRow">
                      <Border Background="#1A1E26"
                              BorderBrush="#2A3040"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="8">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock FontSize="11" Foreground="#E0A458"
                                       Text="{Binding StartTimeDisplay}"/>
                            <TextBlock FontSize="11" Foreground="#E0A458" Text="–"/>
                            <TextBlock FontSize="11" Foreground="#E0A458"
                                       Text="{Binding EndTimeDisplay}"/>
                            <TextBlock FontSize="11" Foreground="#E0A458" Text="("/>
                            <TextBlock FontSize="11" Foreground="#E0A458"
                                       Text="{Binding SourceTimezoneLabel}"/>
                            <TextBlock FontSize="11" Foreground="#E0A458" Text="→"/>
                            <TextBlock FontSize="11" Foreground="#E0A458"
                                       Text="{Binding DisplayTimezoneLabel}"/>
                            <TextBlock FontSize="11" Foreground="#E0A458" Text=")"/>
                            <TextBlock FontSize="11" Foreground="#E0A458" Text="—"/>
                            <TextBlock FontSize="11" Foreground="#E0A458"
                                       Text="{Binding Multiplier, StringFormat={}{0}× multiplier}"/>
                          </StackPanel>
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Peak input:"
                                       FontSize="11" Foreground="#7F8794"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PeakInputRate, StringFormat='${0} per 1M tokens'}"
                                       FontSize="11" Foreground="#E7ECF3"
                                       VerticalAlignment="Center"/>
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Peak output:"
                                       FontSize="11" Foreground="#7F8794"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PeakOutputRate, StringFormat='${0} per 1M tokens'}"
                                       FontSize="11" Foreground="#E7ECF3"
                                       VerticalAlignment="Center"/>
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Peak cached input:"
                                       FontSize="11" Foreground="#7F8794"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PeakCachedInputRate, StringFormat='${0} per 1M tokens'}"
                                       FontSize="11" Foreground="#E7ECF3"
                                       VerticalAlignment="Center"/>
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="Peak cache write:"
                                       FontSize="11" Foreground="#7F8794"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PeakCacheWriteDisplay}"
                                       FontSize="11" Foreground="#E7ECF3"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
