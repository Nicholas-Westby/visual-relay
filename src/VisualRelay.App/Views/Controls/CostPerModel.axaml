<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualRelay.App.ViewModels"
             x:Class="VisualRelay.App.Views.Controls.CostPerModel"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">
  <StackPanel Spacing="6">
    <ItemsControl ItemsSource="{Binding ModelCostRows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MainWindowViewModel+ModelCostRow">
          <Border Background="#12151C"
                  BorderBrush="#252A33"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10">
            <StackPanel Spacing="4">
              <!-- Header: model name + tier badges -->
              <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Active header -->
                <TextBlock Text="{Binding ModelKey}"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#F2F5FA"
                           IsVisible="{Binding IsActive}"
                           VerticalAlignment="Center"/>
                <!-- Inactive header -->
                <TextBlock Text="{Binding ModelKey}"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#9AA3B1"
                           IsVisible="{Binding !IsActive}"
                           VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding TierBadges}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Background="#2E4B6E"
                              CornerRadius="8"
                              Padding="6,1">
                        <TextBlock Text="{Binding .}"
                                   FontSize="10"
                                   Foreground="#CFE0F5"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Priced state: rate rows + windows -->
              <StackPanel Spacing="4" IsVisible="{Binding IsPriced}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Input:"
                             FontSize="12" Foreground="#9AA3B1"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding InputDisplay}"
                             FontSize="12" Foreground="#E7ECF3"
                             VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Output:"
                             FontSize="12" Foreground="#9AA3B1"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding OutputDisplay}"
                             FontSize="12" Foreground="#E7ECF3"
                             VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Cached input:"
                             FontSize="12" Foreground="#9AA3B1"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding CachedInputDisplay}"
                             FontSize="12" Foreground="#E7ECF3"
                             VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Cache write:"
                             FontSize="12" Foreground="#9AA3B1"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding CacheWriteDisplay}"
                             FontSize="12" Foreground="#E7ECF3"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Time-of-day windows -->
                <StackPanel Spacing="4"
                            IsVisible="{Binding HasWindows}"
                            Margin="0,4,0,0">
                  <ItemsControl ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MainWindowViewModel+ModelCostWindowRow">
                        <Border Background="#1A1E26"
                                BorderBrush="#2A3040"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Headline}"
                                       FontSize="11" Foreground="#E0A458"/>
                            <TextBlock Text="{Binding SourceNote}"
                                       FontSize="10" Foreground="#7F8794"
                                       IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="Peak input:"
                                         FontSize="11" Foreground="#7F8794"
                                         VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding PeakInputDisplay}"
                                         FontSize="11" Foreground="#E7ECF3"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="Peak output:"
                                         FontSize="11" Foreground="#7F8794"
                                         VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding PeakOutputDisplay}"
                                         FontSize="11" Foreground="#E7ECF3"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="Peak cached input:"
                                         FontSize="11" Foreground="#7F8794"
                                         VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding PeakCachedInputDisplay}"
                                         FontSize="11" Foreground="#E7ECF3"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="Peak cache write:"
                                         FontSize="11" Foreground="#7F8794"
                                         VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding PeakCacheWriteDisplay}"
                                         FontSize="11" Foreground="#E7ECF3"
                                         VerticalAlignment="Center"/>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Unpriced state -->
              <TextBlock Text="pricing not configured for this model"
                         FontSize="12" Foreground="#7F8794"
                         IsVisible="{Binding !IsPriced}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
