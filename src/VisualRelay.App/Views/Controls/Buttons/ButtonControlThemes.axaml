<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:buttons="using:VisualRelay.App.Views.Controls.Buttons">

  <!-- CommonButton: hosts a single inner Button. All property forwarding
       and variant class application are handled in code-behind. -->
  <Style Selector="buttons|CommonButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Button Name="PART_Button"/>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- IconButton: hosts a single inner Button. All property forwarding
       and icon/content composition are handled in code-behind. -->
  <Style Selector="buttons|IconButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Button Name="PART_Button"/>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- StageCardButton: hosts a single inner Button. All property forwarding
       and class application are handled in code-behind. -->
  <Style Selector="buttons|StageCardButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Button Name="PART_Button"/>
      </ControlTemplate>
    </Setter>
  </Style>

</Styles>
