<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualRelay.App.ViewModels"
             x:Class="VisualRelay.App.Views.Controls.TimeoutSettings"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">
  <Border Background="#12151C" BorderBrush="#252A33" BorderThickness="1" CornerRadius="4" Padding="10">
    <StackPanel Spacing="6">
      <TextBlock Text="Timeouts" FontSize="13" FontWeight="Bold" Foreground="#F2F5FA"/>
      <TextBlock Text="Edits apply from the next run. The stage timeout is ×10 for tasks with the 10× turn-budget boost."
                 FontSize="11" Foreground="#9AA3B1" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="Auto,80" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stage timeout (minutes)"
                   Foreground="#E7ECF3" FontSize="12" VerticalAlignment="Center"
                   ToolTip.Tip="Hard absolute wall-clock ceiling per stage invocation. Applies from the next run."/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding StageTimeoutMinutes, Mode=TwoWay}"
                 FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Test timeout (minutes)"
                   Foreground="#E7ECF3" FontSize="12" VerticalAlignment="Center"
                   ToolTip.Tip="Maximum time allowed for the test command. Applies from the next run."/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding TestTimeoutMinutes, Mode=TwoWay}"
                 FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
