<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualRelay.App.ViewModels"
             xmlns:domain="using:VisualRelay.Domain"
             xmlns:runLogRows="using:VisualRelay.App.ViewModels.RunLogRows"
             xmlns:buttons="using:VisualRelay.App.Views.Controls.Buttons"
             x:Class="VisualRelay.App.Views.Controls.RunLogView"
             x:DataType="vm:MainWindowViewModel">
  <ListBox Margin="12"
           ItemsSource="{Binding Events}">
    <ListBox.DataTemplates>
      <!-- Heartbeat group row: header with count + chevron + expandable members -->
      <DataTemplate DataType="{x:Type runLogRows:HeartbeatGroupRow}">
        <Grid RowDefinitions="Auto,Auto,Auto"
              Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <buttons:IconButton Grid.Column="0"
                              IconStyle="CollapseToggle"
                              ChevronDirection="{Binding ChevronDirection}"
                              Command="{Binding ToggleExpandCommand}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"/>
          <TextBlock Grid.Column="1"
                     Classes="logHeader"
                     Classes.attention="{Binding IsAttention}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} ×{1}">
                <Binding Path="DisplayLine"/>
                <Binding Path="Count"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Grid.Column="2"
                     Classes="logTime"
                     Text="{Binding Event.TimeLabel}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"/>
          <SelectableTextBlock Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding DetailLine}"
                                ToolTip.Tip="{Binding DetailLine}"
                                Classes="logDetail"
                                FontFamily="Menlo,Consolas,monospace"
                                FontSize="12"
                                Foreground="#7F8794"/>
          <ItemsControl Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        IsVisible="{Binding IsExpanded}"
                        ItemsSource="{Binding Members}"
                        Margin="20,4,0,0">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="{x:Type domain:RelayEvent}">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding DisplayLine}"
                             ToolTip.Tip="{Binding DisplayLine}"
                             Classes="logHeader"
                             Classes.attention="{Binding IsAttention}"/>
                  <TextBlock Grid.Column="1"
                             Classes="logTime"
                             Text="{Binding TimeLabel}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                  <SelectableTextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding DetailLine}"
                                       ToolTip.Tip="{Binding DetailLine}"
                                       Classes="logDetail"
                                       Classes.attention="{Binding IsAttention}"
                                       FontFamily="Menlo,Consolas,monospace"
                                       FontSize="12"
                                       Foreground="#7F8794"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </Grid>
      </DataTemplate>

      <!-- Single event row: identical to today's rendering -->
      <DataTemplate DataType="{x:Type runLogRows:SingleEventRow}">
        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,10">
          <TextBlock Grid.Column="0"
                     Text="{Binding DisplayLine}"
                     ToolTip.Tip="{Binding DisplayLine}"
                     Classes="logHeader"
                     Classes.attention="{Binding IsAttention}"/>
          <TextBlock Grid.Column="1"
                     Classes="logTime"
                     Text="{Binding Event.TimeLabel}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"/>
          <SelectableTextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding DetailLine}"
                               ToolTip.Tip="{Binding DetailLine}"
                               Classes="logDetail"
                               Classes.attention="{Binding IsAttention}"
                               FontFamily="Menlo,Consolas,monospace"
                               FontSize="12"
                               Foreground="#7F8794"/>
        </Grid>
      </DataTemplate>
    </ListBox.DataTemplates>
  </ListBox>
</UserControl>
