{
  "extends": "default",
  "meta": {
    "name": "vr-guard",
    "description": "Visual Relay guard: broad read + network + tools open; writes and deletes confined to the granted workspace. Accident containment, not adversarial isolation."
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "read": [
      { "path": "/", "when": "macos" },
      { "path": "/usr", "when": "linux" },
      { "path": "/etc", "when": "linux" },
      { "path": "/opt", "when": "linux" },
      { "path": "/var", "when": "linux" },
      { "path": "/srv", "when": "linux" },
      { "path": "/snap", "when": "linux" },
      { "path": "/nix", "when": "linux" },
      "$HOME/.gitconfig"
    ],
    "allow": [
      "$TMPDIR",
      "$HOME/.nuget/packages",
      "$HOME/.dotnet",
      "$HOME/.templateengine",
      { "path": "$HOME/Library/Caches/NuGet", "when": "macos" },
      { "path": "$XDG_CACHE_HOME/NuGet", "when": "linux" },
      "$HOME/.local/share/NuGet",
      { "path": "$HOME/.local/share/uv", "when": "linux" },
      "$HOME/.swiftpm",
      { "path": "$HOME/Library/Caches/org.swift.swiftpm", "when": "macos" },
      { "path": "$HOME/Library/org.swift.swiftpm", "when": "macos" },
      { "path": "$HOME/.cache/org.swift.swiftpm", "when": "linux" },
      { "path": "$XDG_CACHE_HOME/org.swift.swiftpm", "when": "linux" },
      "$HOME/.npm",
      "$HOME/.bun",
      "$HOME/.deno",
      "$HOME/.pnpm-store",
      "$HOME/.yarn",
      "$HOME/.cloakbrowser",
      { "path": "$HOME/Library/Caches/node-gyp", "when": "macos" },
      "$HOME/.pyenv",
      { "path": "$HOME/Library/Caches/pip", "when": "macos" },
      { "path": "$HOME/Library/Caches/uv", "when": "macos" },
      { "path": "$HOME/.cache/pip", "when": "linux" },
      { "path": "$HOME/.cache/uv", "when": "linux" },
      { "path": "$XDG_CACHE_HOME/pip", "when": "linux" },
      { "path": "$XDG_CACHE_HOME/uv", "when": "linux" },
      "$HOME/go/pkg/mod",
      { "path": "$HOME/Library/Caches/go-build", "when": "macos" },
      { "path": "$HOME/.cache/go-build", "when": "linux" },
      { "path": "$XDG_CACHE_HOME/go-build", "when": "linux" },
      "$HOME/.cargo",
      "$HOME/.m2",
      "$HOME/.gradle",
      "$HOME/.cache/nix",
      "$HOME/.local/state/nix",
      { "path": "$HOME/Library/Unity", "when": "macos" },
      { "path": "$HOME/Library/Application Support/Unity", "when": "macos" },
      { "path": "$HOME/Library/Application Support/UnityHub", "when": "macos" },
      { "path": "/dev/shm", "when": "linux" }
    ],
    "write": [
    ],
    "deny": [
      "$HOME/Documents",
      "$HOME/Desktop",
      "$HOME/Pictures",
      "$HOME/Movies",
      "$HOME/Music"
    ]
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "readwrite"
  },
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      "__pycache__",
      ".nuget",
      "NuGet",
      ".dotnet",
      ".templateengine",
      ".swiftpm",
      "org.swift.swiftpm",
      ".npm",
      ".bun",
      ".deno",
      ".pnpm-store",
      ".yarn",
      "node-gyp",
      ".pyenv",
      ".cargo",
      ".cache",
      ".cloakbrowser",
      "Caches",
      "/go/pkg/",
      "/.local/state/nix",
      "/.local/share/uv",
      "/.local/share/JetBrains",
      "/Library/Unity",
      "/Library/Application Support/Unity",
      "/Library/Application Support/UnityHub",
      "/Library/Application Support/JetBrains",
      "/var/folders/"
    ],
    "exclude_globs": [
      "*.pyc"
    ]
  },
  "groups": {
    "include": [
      "python_runtime",
      "node_runtime",
      "user_caches_macos",
      "user_caches_linux",
      "linux_sysfs_read",
      "git_config",
      "unlink_protection",
      "go_runtime",
      "rust_runtime",
      "java_runtime",
      "linux_runtime_state",
      "linux_temp_read",
      "nix_runtime"
    ]
  },
  "allow_parent_of_protected": true,
  "unsafe_macos_seatbelt_rules": [
    "(allow user-preference-read)",
    "(allow ipc-posix-shm*)",
    "(allow mach-register)",
    "(allow sysctl-read)",
    "(allow iokit-open)",
    "(allow iokit-get-properties)",
    "(allow system-socket)"
  ]
}
